# ==============================================================================
# Title:           Foundry Visiting Card Path Redirection (vcardfoundry)
# Purpose/Features: Intercepts source path /vcardfoundry and performs a 302 
#                  redirect to the live foundry page with UTM tracking tags.
# Revision History:
#   Version: 1.1
#   Date:    2026-10-04
#   Author:  SDS
#   Changes: Updated source route path from vfoundrycard to vcardfoundry
# ==============================================================================

<IfModule mod_rewrite.c>
RewriteEngine On

# Source URL: https://www.gompatech.com/vcardfoundry
# Target URL: https://www.gompatech.com/foundry
RewriteRule ^vcardfoundry/?$ https://www.gompatech.com/foundry?utm_source=visiting_card&utm_medium=qr&utm_campaign=foundry [R=302,L]
</IfModule>
